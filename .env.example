# Copy this file to .env for local development. Do not commit .env.
# Values prefixed with VITE_ are exposed to the browser; never put server secrets in them.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Server-only credentials: configure these in the deployment environment.
LOVABLE_API_KEY=
GOOGLE_MAPS_API_KEY=
